{
  "name": "knowledgebase-app",
  "version": "0.1.0",
  "private": true,
  "description": "Private SaaS Maker Knowledgebase operator dashboard with Cloudflare Access and project-scoped Worker access.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "wrangler pages dev dist",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint",
    "cf:build": "pnpm build",
    "preview:cf": "pnpm build && wrangler pages dev dist",
    "deploy:cf": "pnpm build && wrangler pages deploy dist --project-name=knowledgebase-app"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "jose": "6.2.4",
    "lucide-react": "1.11.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwind-merge": "3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "4.1.5",
    "eslint": "^9.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "globals": "^16.0.0",
    "lightningcss": "^1.32.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.10",
    "vitest": "4.1.5",
    "wrangler": "^4.0.0"
  },
  "pnpm": {
    "overrides": {
      "miniflare>sharp": "0.35.4",
      "@eslint/eslintrc>js-yaml": "4.3.2"
    }
  }
}
